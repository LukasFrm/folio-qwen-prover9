formulas(assumptions).
(((((all v_x ((p_spill_on(v_x, c_a_lot_of_food, c_clothing) -> -(p_notably_tidy(v_x)))) & all v_x (((p_clumsy_foodie(v_x) & p_go_out_frequently_to_find_to_try(v_x, c_new_food_restaurant)) -> p_spill_on(v_x, c_a_lot_of_food, c_clothing)))) & all v_x ((p_cleanly(v_x) -> p_notably_tidy(v_x)))) & all v_x (((p_value(v_x, c_order) & p_value(v_x, c_spotlessness)) -> p_cleanly(v_x)))) & all v_x ((exists v_y (((p_family_of(v_y, v_x) & p_prioritize(v_y, c_order)) & p_prioritize(v_y, c_spotlessness))) -> (p_value(v_x, c_order) & p_value(v_x, c_spotlessness))))) & -(((p_spill_on(c_peter, c_a_lot_of_food, c_clothing) | p_cleanly(c_peter)) & -(p_spill_on(c_peter, c_a_lot_of_food, c_clothing) & p_cleanly(c_peter))))).
