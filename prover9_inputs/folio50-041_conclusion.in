(((((all v_x ((p_regularly_eat(v_x, c_salad) -> (p_conscious_about(v_x, c_health) & p_conscious_about(v_x, c_eating_habit)))) & all v_x ((p_grew_up_in(v_x, c_health_conscious_childhood_home) -> p_regularly_eat(v_x, c_salad)))) & all v_x ((p_fulfill(v_x, c_daily_nutritional_intake) -> p_grew_up_in(v_x, c_health_conscious_childhood_home)))) & all v_x ((p_disregard(v_x, c_physical_wellbeing) -> -((p_conscious_about(v_x, c_health) & p_conscious_about(v_x, c_eating_habit)))))) & all v_x ((p_visit_daily(v_x, c_gym) -> p_fulfill(v_x, c_daily_nutritional_intake)))) & -(((p_grew_up_in(c_taylor, c_health_conscious_childhood_home) | p_disregard(c_taylor, c_physical_wellbeing)) & -(p_grew_up_in(c_taylor, c_health_conscious_childhood_home) & p_disregard(c_taylor, c_physical_wellbeing))))).
