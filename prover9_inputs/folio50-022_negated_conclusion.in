formulas(assumptions).
(((((all v_x ((p_born_in(v_x, c_multiple_birth) -> p_spend_time_playing_with(v_x, c_siblings))) & all v_x ((exists v_y ((p_sibling(v_x, v_y) & p_born_together(v_x, v_y))) -> p_born_in(v_x, c_multiple_birth)))) & all v_x ((p_complain_about_often(v_x, c_annoying_siblings) -> exists v_y ((p_sibling(v_x, v_y) & p_born_together(v_x, v_y)))))) & all v_x ((p_live_at(v_x, c_home) -> -(p_live_with(v_x, c_strangers))))) & all v_x ((p_spend_time_playing_with(v_x, c_siblings) -> p_live_at(v_x, c_home)))) & -(((p_born_in(c_luke, c_multiple_birth) | p_live_with(c_luke, c_strangers)) & -(p_born_in(c_luke, c_multiple_birth) & p_live_with(c_luke, c_strangers))))).
