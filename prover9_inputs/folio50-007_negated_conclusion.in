formulas(assumptions).
(((((p_professional_wrestling_stable(c_diamond_mine) & p_in(c_diamond_mine, c_w_w_e)) & p_leads(c_roderick_strong, c_diamond_mine)) & p_includes(c_diamond_mine, c_creed_brothers)) & p_includes(c_diamond_mine, c_ivy_nile)) & p_feuds(c_imperium, c_diamond_mine)).
-(c_creed_brothers = c_diamond_mine).
-(c_creed_brothers = c_imperium).
-(c_creed_brothers = c_ivy_nile).
-(c_creed_brothers = c_roderick_strong).
-(c_creed_brothers = c_w_w_e).
-(c_diamond_mine = c_imperium).
-(c_diamond_mine = c_ivy_nile).
-(c_diamond_mine = c_roderick_strong).
-(c_diamond_mine = c_w_w_e).
-(c_imperium = c_ivy_nile).
-(c_imperium = c_roderick_strong).
-(c_imperium = c_w_w_e).
-(c_ivy_nile = c_roderick_strong).
-(c_ivy_nile = c_w_w_e).
-(c_roderick_strong = c_w_w_e).
end_of_list.

formulas(goals).
-(exists v_x ((p_leads(c_roderick_strong, v_x) & p_professional_wrestling_stable(v_x)))).
end_of_list.
