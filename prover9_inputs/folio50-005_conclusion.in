formulas(assumptions).
((((((all v_x ((p_alien(v_x) -> p_extraterrestrial(v_x))) & all v_x ((p_from(v_x, c_mars) -> p_alien(v_x)))) & all v_x ((p_extraterrestrial(v_x) -> -(p_human(v_x))))) & all v_x (((p_highly_intelligent_being(v_x) & p_from(v_x, c_earth)) -> p_human(v_x)))) & p_highly_intelligent_being(c_marvin)) & -(((p_from(c_marvin, c_earth) | p_from(c_marvin, c_mars)) & -(p_from(c_marvin, c_earth) & p_from(c_marvin, c_mars))))) & (-(p_from(c_marvin, c_earth)) -> p_extraterrestrial(c_marvin))).
