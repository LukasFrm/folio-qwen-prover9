formulas(assumptions).
((p_sporting_event(c_olympics) & p_last_summer_olympics(c_tokyoolympics)) & p_most_medals(c_united_states, c_tokyoolympics)).
-(c_olympics = c_tokyoolympics).
-(c_olympics = c_united_states).
-(c_tokyoolympics = c_united_states).
end_of_list.

formulas(goals).
exists v_x ((p_last_summer_olympics(v_x) & p_most_medals(c_united_states, v_x))).
end_of_list.
